input(a)
input(b)
c <- 0

for i <- 1 to 5 do
    c <- a + b
    c <- c - b
    c <- c * a
    c <- c / 1
endfor

output c

i <- 5

while i = 5 do 
    c <- a + b
    c <- c - b
    c <- c * a
    c <- c / 1
    i <- i - 1
endwhile

output c

if c >= 100 then 
    output 999 
else 
    output 111 
endif